# GEMINI_API_KEY: Required for server-side Gemini AI calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform JavaScript API Key (required for live interactive map & AdvancedMarker)
VITE_GOOGLE_MAPS_API_KEY=""

# Supabase Project Configuration (Milestone 3: PostgreSQL persistence for trash reports)
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon Key (Public Key Safe for Browser Use)
# Found in Supabase Dashboard -> Project Settings -> API -> anon public key
# NEVER use service_role secret key in frontend client code!
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"